{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vextessera",
  "version": "0.6.0-alpha.1",
  "identifier": "org.stemvisualexplorer.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Vextessera",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "frame-src https://falstad.com https://www.falstad.com;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "nsis": { "installMode": "currentUser" }
    },
    "category": "Education",
    "shortDescription": "Source-grounded STEM knowledge and ManimGL visualization.",
    "longDescription": "Vextessera connects source-grounded STEM knowledge retrieval, independently checked mathematical models, guided numerical lessons and native ManimGL scene authoring, preview and rendering.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../LICENSE": "licenses/Vextessera-AGPL-3.0.txt",
      "../THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md",
      "../licenses/": "licenses/dependencies/"
    }
  }
}

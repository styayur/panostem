{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Panostem",
  "version": "0.5.0-alpha.1",
  "identifier": "org.stemvisualexplorer.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Panostem",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Concept-driven STEM learning with native ManimGL authoring.",
    "longDescription": "Panostem combines concept-driven STEM resource discovery, guided numerical lessons and native ManimGL scene authoring, preview and rendering.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../LICENSE": "licenses/Panostem-AGPL-3.0.txt",
      "../THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md",
      "../licenses/": "licenses/dependencies/"
    }
  }
}

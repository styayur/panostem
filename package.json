    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.64.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
